// 按模型原始画布比例缩放，保持纵横比，居中显示
function fitSprite(s) {
  const size = s.getModelCanvasSize()
  if (!size) return
  const screen = app.renderer.screen
  const margin = 0.07 // 四周留白比例
  const scale = Math.min(
    (screen.width * (1 - margin)) / size.width,
    (screen.height * (1 - margin)) / size.height,
  )
  s.setSize({ width: size.width * scale, height: size.height * scale })
  s.x = (screen.width - s.width) / 2
  s.y = (screen.height - s.height) / 2
}

